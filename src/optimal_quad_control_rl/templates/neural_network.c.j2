/* ---- Network primitives ---- */

static void nn_linear(const float *weights, const float *biases,
                      const float *input, int in_features, int out_features,
                      float *output) {
    for (int i = 0; i < out_features; ++i) {
        float neuron = biases[i];
        for (int j = 0; j < in_features; ++j) {
            neuron += input[j] * weights[i * in_features + j];
        }
        output[i] = neuron;
    }
}

static void nn_relu(float *x, int size) {
    for (int i = 0; i < size; ++i) {
        x[i] = fmaxf(0.0f, x[i]);
    }
}

static void nn_tanh(float *x, int size) {
    for (int i = 0; i < size; ++i) {
        x[i] = tanhf(x[i]);
    }
}

/* ---- Forward pass ---- */

void nn_forward(const float *input, float *output) {
{% for step in forward_steps %}
